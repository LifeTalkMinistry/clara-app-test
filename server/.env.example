NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://clara:change-me@localhost:5432/clara_accounts
DATABASE_SSL=false
CLARA_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
CLARA_ADMIN_ACCESS_TOKEN_SECRET=replace-with-a-different-at-least-32-byte-secret
CLARA_ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=1$replace-with-generated-hash
CLARA_ADMIN_IDENTIFIER=clara-owner
CLARA_ALLOWED_ORIGINS=http://localhost:5173,https://lifetalkministry.github.io,capacitor://localhost,http://localhost
CLARA_REFRESH_COOKIE_NAME=clara_refresh
CLARA_ADMIN_REFRESH_COOKIE_NAME=clara_admin_refresh
CLARA_COOKIE_DOMAIN=
CLARA_ACCESS_TOKEN_TTL_SECONDS=900
CLARA_REFRESH_TOKEN_TTL_DAYS=30
CLARA_ADMIN_TOKEN_TTL_SECONDS=900
CLARA_ADMIN_REFRESH_TOKEN_TTL_HOURS=12
CLARA_OFFLINE_GRACE_HOURS=24
TRUST_PROXY=false
