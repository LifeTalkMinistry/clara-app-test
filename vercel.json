{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npx vite build --base=./",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/clara-api/:path*",
      "destination": "https://myself-infinite-road-bookmark.trycloudflare.com/:path*"
    }
  ]
}
