{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "installCommand": "npm install --ignore-scripts --no-audit --no-fund --package-lock=false",
  "buildCommand": "python3 scripts/patch-savings-goal-complete.py && npx vite build --base=./",
  "outputDirectory": "dist"
}
