// SavingsGoal Model (no base44)

export const SavingsGoalSchema = {
  name: "SavingsGoal",

  fields: {
    title: "",

    category: "",
    subcategory: "",

    target_amount: 0,
    saved_amount: 0,

    planned_use_date: "",

    reasons: [],

    emotional_value: "security", // joy | security | experience | milestone
    flexibility: "flexible", // flexible | must_have
    priority: "medium", // low | medium | high | urgent

    notes: "",

    wallet_id: "",
  },

  emotionalValues: ["joy", "security", "experience", "milestone"],
  flexibilityTypes: ["flexible", "must_have"],
  priorityLevels: ["low", "medium", "high", "urgent"],
};

// Helper
export function createSavingsGoal(data) {
  return {
    title: data.title || "",

    category: data.category || "",
    subcategory: data.subcategory || "",

    target_amount: data.target_amount ?? 0,
    saved_amount: data.saved_amount ?? 0,

    planned_use_date: data.planned_use_date || "",

    reasons: data.reasons || [],

    emotional_value: data.emotional_value || "security",
    flexibility: data.flexibility || "flexible",
    priority: data.priority || "medium",

    notes: data.notes || "",

    wallet_id: data.wallet_id || "",

    created_at: new Date().toISOString(),
  };
}