// Journey Model (no base44)

export const JourneySchema = {
  name: "Journey",

  fields: {
    user_id: "",
    user_email: "",

    start_date: "", // YYYY-MM-DD
    end_date: "",

    is_active: true,

    starting_balance: 0,
    starting_expenses: 0,
  },
};

// Helper
export function createJourney(data) {
  return {
    user_id: data.user_id || "",
    user_email: data.user_email || "",

    start_date: data.start_date || "",
    end_date: data.end_date || "",

    is_active: data.is_active ?? true,

    starting_balance: data.starting_balance ?? 0,
    starting_expenses: data.starting_expenses ?? 0,

    created_at: new Date().toISOString(),
  };
}