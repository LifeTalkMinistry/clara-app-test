{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["cash", "gcash", "bank", "maya", "credit_card", "other"]
    },
    "starting_balance": {
      "type": "number"
    },
    "current_balance": {
      "type": "number"
    },
    "icon": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "user_id",
    "name",
    "type",
    "starting_balance",
    "current_balance",
    "created_at",
    "updated_at"
  ]
}