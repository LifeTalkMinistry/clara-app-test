// AppSettings Model (no base44)

export const AppSettingsSchema = {
  name: "AppSettings",

  fields: {
    key: "",
    value: "",
    label: "",
  },
};

// Helper to create setting
export function createAppSetting(data) {
  return {
    key: data.key || "",
    value: data.value || "",
    label: data.label || "",
    created_at: new Date().toISOString(),
  };
}