// ReferralMaterial Model (no base44)

export const ReferralMaterialSchema = {
  name: "ReferralMaterial",

  fields: {
    title: "",
    description: "",

    category: "other", // social_posts | images | captions | program_explainers | ambassador_training | other
    type: "text", // image | file | link | text

    file_url: "",
    content: "",

    is_active: true,
    sort_order: 0,
  },

  categories: [
    "social_posts",
    "images",
    "captions",
    "program_explainers",
    "ambassador_training",
    "other",
  ],

  types: ["image", "file", "link", "text"],
};

// Helper
export function createReferralMaterial(data) {
  return {
    title: data.title || "",
    description: data.description || "",

    category: data.category || "other",
    type: data.type || "text",

    file_url: data.file_url || "",
    content: data.content || "",

    is_active: data.is_active ?? true,
    sort_order: data.sort_order ?? 0,

    created_at: new Date().toISOString(),
  };
}