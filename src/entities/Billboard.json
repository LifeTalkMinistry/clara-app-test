// Billboard Model (no base44)

export const BillboardSchema = {
  name: "Billboard",

  fields: {
    title: "",
    body: "",
    media_url: "",
    media_type: "none", // image | video | pdf | file | none
    file_name: "",
    is_active: true,
    sort_order: 0,
  },

  mediaTypes: ["image", "video", "pdf", "file", "none"],
};

// Helper
export function createBillboard(data) {
  return {
    title: data.title || "",
    body: data.body || "",
    media_url: data.media_url || "",
    media_type: data.media_type || "none",
    file_name: data.file_name || "",
    is_active: data.is_active ?? true,
    sort_order: data.sort_order ?? 0,
    created_at: new Date().toISOString(),
  };
}