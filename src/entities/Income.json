// Income Model (no base44)

export const IncomeSchema = {
  name: "Income",

  fields: {
    amount: 0,
    source: "",
    wallet_id: "",
    date: "", // YYYY-MM-DD
    notes: "",
  },
};

// Helper
export function createIncome(data) {
  return {
    amount: data.amount ?? 0,
    source: data.source || "",
    wallet_id: data.wallet_id || "",
    date: data.date || "",
    notes: data.notes || "",
    created_at: new Date().toISOString(),
  };
}