// AdminNote Model (no base44)

export const AdminNoteSchema = {
  name: "AdminNote",

  fields: {
    user_id: "",
    user_email: "",
    content: "",
    event_type: "note", // default
    admin_email: "",
  },

  eventTypes: [
    "note",
    "enrolled",
    "approved",
    "journey_started",
    "journey_reset",
    "plan_changed",
    "rejected",
    "paused",
    "tier_changed",
  ],
};

// Optional helper (for creating new notes)
export function createAdminNote(data) {
  return {
    user_id: data.user_id || "",
    user_email: data.user_email || "",
    content: data.content || "",
    event_type: data.event_type || "note",
    admin_email: data.admin_email || "",
    created_at: new Date().toISOString(),
  };
}