// Referral Model (no base44)

export const ReferralSchema = {
  name: "Referral",

  fields: {
    referrer_email: "",
    referrer_name: "",

    referral_code: "",

    new_user_email: "",
    new_user_name: "",

    enrollment_id: "",

    plan: "",

    amount_paid: 0,

    commission_percentage: 50,
    commission_amount: 0,

    status: "pending", // pending | approved | paid | rejected

    referral_date: "",
    approval_date: "",
  },

  statusTypes: ["pending", "approved", "paid", "rejected"],
};

// Helper
export function createReferral(data) {
  return {
    referrer_email: data.referrer_email || "",
    referrer_name: data.referrer_name || "",

    referral_code: data.referral_code || "",

    new_user_email: data.new_user_email || "",
    new_user_name: data.new_user_name || "",

    enrollment_id: data.enrollment_id || "",

    plan: data.plan || "",

    amount_paid: data.amount_paid ?? 0,

    commission_percentage: data.commission_percentage ?? 50,
    commission_amount: data.commission_amount ?? 0,

    status: data.status || "pending",

    referral_date: data.referral_date || "",
    approval_date: data.approval_date || "",

    created_at: new Date().toISOString(),
  };
}