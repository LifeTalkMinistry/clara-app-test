// DailyTip Model (no base44)

export const DailyTipSchema = {
  name: "DailyTip",

  fields: {
    text: "",
    category: "mindset", // mindset | budgeting | savings | spending | investing | habits | system

    audience: "all", // all | free | pending | paid
    status: "pending", // active | inactive | pending

    source: "admin", // admin | student

    submitter_email: "",
    submitter_name: "",

    approved_by: "",

    scheduled_date: "", // YYYY-MM-DD
  },

  categories: [
    "mindset",
    "budgeting",
    "savings",
    "spending",
    "investing",
    "habits",
    "system",
  ],

  audiences: ["all", "free", "pending", "paid"],

  statusTypes: ["active", "inactive", "pending"],

  sourceTypes: ["admin", "student"],
};

// Helper
export function createDailyTip(data) {
  return {
    text: data.text || "",
    category: data.category || "mindset",

    audience: data.audience || "all",
    status: data.status || "pending",

    source: data.source || "admin",

    submitter_email: data.submitter_email || "",
    submitter_name: data.submitter_name || "",

    approved_by: data.approved_by || "",

    scheduled_date: data.scheduled_date || "",

    created_at: new Date().toISOString(),
  };
}